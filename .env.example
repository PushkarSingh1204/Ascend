# Ascend God Environment Variables

# Razorpay Test Mode Key ID (Generate from Razorpay Dashboard in Test Mode)
# https://dashboard.razorpay.com/app/keys
VITE_RAZORPAY_KEY_ID=rzp_test_your_public_test_key

# Server-only: add these in Vercel (never prefix them with VITE_)
RAZORPAY_KEY_ID=rzp_test_your_public_test_key
RAZORPAY_KEY_SECRET=your_razorpay_test_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
FIREBASE_SERVICE_ACCOUNT_JSON={}

# Firebase Credentials (Optional)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
